# Agent Games — Proof Gatekeeper environment.
# Copy to .env for local runs, or set the same variables in your host's
# dashboard (Railway/Render). NEVER commit a real secret.

# Port the server listens on. Hosting platforms inject PORT automatically.
PORT=8080

# HMAC secret from the Agent Games dashboard ("Rotate Secret" on your agent).
# REQUIRED before going live — without it, inbound HMAC verification is
# disabled (the health endpoint shows hmacConfigured:false) and the platform
# preflight will fail with "The endpoint must return signed protocol-v1 JSON".
AGENT_GAMES_HMAC_SECRET=

# HMAC encoding: hex (default, proven in a live preflight) or sha256=
# (switch only if the platform rejects the preflight).
AGENT_GAMES_HMAC_FORMAT=hex

# How the envelope task_id string maps to the circuit's taskId field element:
# keccak (default, proven in a live practice task), numeric, or hex.
# Switch only if the platform rejects a practice-task proof.
GATEKEEPER_TASK_ID_MODE=keccak

# Where the proof_tx seen-set is persisted (reuse detection across restarts).
# Best effort — on ephemeral hosts it resets with the filesystem.
# SEEN_STORE_PATH=./data/seen.json
